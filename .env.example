# =============================================================
# ContentMatrix — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ── SiliconFlow（转录 + 翻译）─────────────────────────────────
SILICONFLOW_API_KEY=sk-...

# ── Bilibili Cookie（推荐填写，否则搜索可能被拦截）────────────
# 获取方法：
#   1. 浏览器打开 bilibili.com 并登录
#   2. 按 F12 → Network 面板 → 刷新页面
#   3. 点击任意一个 bilibili.com 请求
#   4. 在 Request Headers 里找到 Cookie 这一行
#   5. 把整行 Cookie 的值粘贴到下面（很长，一整行）
BILIBILI_COOKIE=

# ── YouTube OAuth2 ────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── 系统 PATH（确保 Next.js 进程能找到 brew 安装的工具）────
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# ── 视频存储目录 ──────────────────────────────────────────────
VIDEO_DOWNLOAD_DIR=./tmp/videos

# ── Edge TTS 语音（可选，默认 en-US-AndrewMultilingualNeural）──
# TTS_VOICE=en-US-GuyNeural
