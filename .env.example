# =============================================================
# ContentMatrix — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ── SiliconFlow（转录 + 翻译）─────────────────────────────────
SILICONFLOW_API_KEY=sk-...

# ── Bilibili Cookie（推荐填写，否则搜索可能被拦截）────────────
# 获取方法：
#   1. 浏览器打开 bilibili.com 并登录
#   2. 按 F12 → Network 面板 → 刷新页面
#   3. 点击任意一个 bilibili.com 请求
#   4. 在 Request Headers 里找到 Cookie 这一行
#   5. 把整行 Cookie 的值粘贴到下面（很长，一整行）
BILIBILI_COOKIE=

# ── Douyin 搜索（推荐使用浏览器方案，无需 Cookie）────────────
# 【推荐方案】运行一次登录脚本，后续搜索全自动：
#   npx tsx scripts/douyin-login.ts
#   在打开的浏览器中登录抖音，关闭窗口后 Session 自动保存。
#
# 【备用方案】也可以直接填 Cookie（浏览器登录 douyin.com → F12 → Network → 复制 Cookie）
#   注意：抖音 API 需要 a_bogus 签名，Cookie 方案可能仅部分有效。
DOUYIN_COOKIE=

# ── 小红书 Cookie（搜索小红书必填）───────────────────────────
# 获取方法同上：浏览器登录 xiaohongshu.com → F12 → Network → 复制 Cookie
XIAOHONGSHU_COOKIE=

# ── YouTube OAuth2 ────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── TikTok Content Posting API ────────────────────────────────
# 获取方法：
#   1. https://developers.tiktok.com/ 创建应用
#   2. 申请 Content Posting API 权限
#   3. 运行: npx tsx scripts/tiktok-auth.ts
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ── 系统 PATH（确保 Next.js 进程能找到 brew 安装的工具）────
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# ── 视频存储目录 ──────────────────────────────────────────────
VIDEO_DOWNLOAD_DIR=./tmp/videos

# ── Edge TTS 语音（可选，默认 en-US-AndrewMultilingualNeural）──
# TTS_VOICE=en-US-GuyNeural
